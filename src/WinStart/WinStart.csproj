<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships with Windows 10 (1903+) and Windows 11, so the app needs no runtime of its own. -->
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>WinStart</RootNamespace>
    <AssemblyName>WinStart</AssemblyName>
    <AssemblyTitle>WinStart</AssemblyTitle>
    <Description>Launches your chosen applications after you sign in to Windows, each after its own delay.</Description>
    <ApplicationIcon>Assets\WinStart.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <!-- Keep the output to a single WinStart.exe: no .pdb, no .exe.config. -->
    <DebugType>embedded</DebugType>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\WinStart.ico" LogicalName="WinStart.ico" />
    <InternalsVisibleTo Include="WinStart.Tests" />
  </ItemGroup>

</Project>
